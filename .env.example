# Public Convex deployment URL used by the agent-side memory client.
CONVEX_URL=
# Shared secret sent by the agent-side memory client, never stored in Convex.
CONVEX_APP_SECRET=
# Convex deployment environment variable that validates CONVEX_APP_SECRET.
APP_SHARED_SECRET=
# Keep all future posting operations simulated unless this is the canonical false value.
DRY_RUN=
# Keep all future posting operations disabled unless this is the canonical true value.
POSTING_ENABLED=
# Positive integer target for posts per week, defaults to 10 when absent or invalid.
TWEET_WEEKLY_TARGET=
# Positive integer maximum number of posts per day, defaults to 2 when absent or invalid.
TWEET_DAILY_CAP=
# Positive integer minimum number of hours between posts, defaults to 4 when absent or invalid.
TWEET_MIN_GAP_HOURS=
# GitHub account to inspect for public build-in-public activity. Defaults to luciengeorge when blank.
GITHUB_USERNAME=
# Optional GitHub token with public read scope only. Never grant private repository scope.
GITHUB_TOKEN=
# Comma or newline separated developer RSS feeds to ingest.
RSS_FEED_URLS=
# Slack bot token allowed to read only the dedicated idea-drop channel.
SLACK_BOT_TOKEN=
# Slack channel ID for the dedicated idea-drop channel.
SLACK_X_CHANNEL_ID=
# Slack channel ID for the private weekly trend digest.
SLACK_CHANNEL_ID=
# Allow private weekly Slack digest delivery only when explicitly true. Defaults to false.
DIGEST_DELIVERY_ENABLED=
# Exa API key used for the optional developer-trend source.
EXA_API_KEY=
# Fixed Exa query for the optional developer-trend source.
EXA_TREND_QUERY=
# X API bearer token for recent search reads. This source has a fixed $25 monthly code cap.
X_BEARER_TOKEN=
# Fixed X recent-search query. X results are normalised as trending candidates.
X_TREND_QUERY=
# Comma or newline separated private repository names that must never enter the candidate pipeline.
LEAK_GUARD_PRIVATE_REPOS=
# Comma or newline separated employer-internal terms that must never enter the candidate pipeline.
LEAK_GUARD_INTERNAL_TERMS=
