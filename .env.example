# Public Convex deployment URL used by the agent-side memory client.
CONVEX_URL=
# Shared secret sent by the agent-side memory client, never stored in Convex.
CONVEX_APP_SECRET=
# Convex deployment environment variable that validates CONVEX_APP_SECRET.
APP_SHARED_SECRET=
# Keep all future posting operations simulated unless this is the canonical false value.
DRY_RUN=
# Keep all future posting operations disabled unless this is the canonical true value.
POSTING_ENABLED=
# Positive integer target for posts per week, defaults to 10 when absent or invalid.
TWEET_WEEKLY_TARGET=
# Positive integer maximum number of posts per day, defaults to 2 when absent or invalid.
TWEET_DAILY_CAP=
# Positive integer minimum number of hours between posts, defaults to 4 when absent or invalid.
TWEET_MIN_GAP_HOURS=
